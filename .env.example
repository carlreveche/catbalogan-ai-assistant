# Database
CATBALOGAN_DB_HOST=localhost
CATBALOGAN_DB_NAME=catbalogan_ai_assistant
CATBALOGAN_DB_USER=root
CATBALOGAN_DB_PASS=

# Optional Google OAuth. Leave blank to disable Google sign-in.
CATBALOGAN_GOOGLE_CLIENT_ID=
CATBALOGAN_GOOGLE_CLIENT_SECRET=
CATBALOGAN_GOOGLE_REDIRECT_URI=http://localhost/catbalogan-ai-assistant/google_auth/callback.php

# Optional Groq fallback. Leave blank to use the offline matcher only.
CATBALOGAN_AI_PROVIDER=groq
CATBALOGAN_AI_MODEL=openai/gpt-oss-20b
CATBALOGAN_AI_API_KEY=
CATBALOGAN_AI_TEMPERATURE=0.2
CATBALOGAN_AI_MAX_TOKENS=800
CATBALOGAN_AI_TIMEOUT=10
CATBALOGAN_AI_FALLBACK_THRESHOLD=40
